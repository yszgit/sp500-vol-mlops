# Copy to .env and fill in. .env is git-ignored: never commit real credentials.

# WRDS account used by `python -m volforecast.ingest` (password is prompted or read from ~/.pgpass)
WRDS_USERNAME=

# MLflow tracking server started by `docker compose up`
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=sp500-volatility
MLFLOW_MODEL_NAME=sp500-vol-forecaster

# Daily panel produced by the ingestion step
DATA_PATH=data/raw/sp500_panel.parquet
